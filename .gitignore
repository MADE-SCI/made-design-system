# dependencies
node_modules/
.pnpm-store/

# build output
# NOTE: dist/ is intentionally NOT gitignored. We ship pre-built artifacts
# in git so the package works as a `github:` install across any package
# manager (npm/bun/yarn/pnpm) regardless of whether their lifecycle scripts
# run `prepare`. The CHANGELOG documents the rebuild-and-commit workflow
# for releases. *.tsbuildinfo IS still ignored — it's TypeScript's incremental
# compile cache, not a deliverable.
*.tsbuildinfo

# logs
*.log
npm-debug.log*
yarn-debug.log*

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# test
coverage/

# env
.env
.env.local
.env.*.local
